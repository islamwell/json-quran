    {
      "id": "103:1",
      "number": 1,
      "text": "وَٱلْعَصْرِ",
      "text_simple": "والعصر",
      "translation": "By time,",
      "transliteration": "Wal-ʿaṣr"
    },
    {
      "id": "103:2",
      "number": 2,
      "text": "إِنَّ ٱلْإِنسَـٰنَ لَفِى خُسْرٍ",
      "text_simple": "إن الإنسان لفي خسر",
      "translation": "Indeed, mankind is in loss,",
      "transliteration": "Inna l-insāna lafī khusr"
    },
    {
      "id": "103:3",
      "number": 3,
      "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ وَتَوَاصَوْا۟ بِٱلْحَقِّ وَتَوَاصَوْا۟ بِٱلصَّبْرِ",
      "text_simple": "إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر",
      "translation": "Except for those who have believed and done righteous deeds and advised each other to truth and advised each other to patience.",
      "transliteration": "Illā l-ladhīna āmanū wa-ʿamilū ṣ-ṣāliḥāti wa-tawāṣaw bil-ḥaqqi wa-tawāṣaw biṣ-ṣabr"
    }
  ],
